# For `docker compose up` (the self-hosted "Path B" deployment described in
# PRODUCTION_ROADMAP.md) ONLY — docker-compose.yml reads this file
# automatically because it lives next to it. This is separate from
# backend/.env.example, which configures the FastAPI app itself
# (YOUTUBE_API_KEY, APIFY_API_TOKEN, etc.) — you need both files when
# self-hosting with Docker Compose.
#
#   cp .env.example .env
#   # then replace the placeholder below with a real random password
#
# There is deliberately no default here: docker-compose.yml requires this
# to be set and refuses to start otherwise, rather than quietly falling
# back to a well-known password that would otherwise ship, unchanged, in
# every clone of this repo's Postgres container.
POSTGRES_PASSWORD=replace-with-a-long-random-password
