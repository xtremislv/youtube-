# ── Database ─────────────────────────────────────────────────────────────────
# Local Docker Postgres example:
#   DATABASE_URL=postgresql+psycopg://dashboard:dashboard@db:5432/dashboard
# Neon / Supabase / Render example (get this from your provider's dashboard):
#   DATABASE_URL=postgresql+psycopg://user:password@host:5432/dbname?sslmode=require
DATABASE_URL=postgresql+psycopg://dashboard:dashboard@localhost:5432/dashboard

# ── YouTube Data API v3 (free) ──────────────────────────────────────────────
# Create a key at https://console.cloud.google.com/apis/credentials after
# enabling "YouTube Data API v3" on a Google Cloud project. Free quota is
# 10,000 units/day per project (see backend/README.md for how this app
# budgets that quota).
YOUTUBE_API_KEY=REPLACE_WITH_YOUR_YOUTUBE_API_KEY

# ── Instagram scraping via Apify ────────────────────────────────────────────
# Sign up free at https://apify.com (no card required, $5 free usage credit
# per month). Create an API token at https://console.apify.com/settings/integrations
APIFY_API_TOKEN=REPLACE_WITH_YOUR_APIFY_TOKEN
# The Apify Actor that scrapes Instagram profiles/reels. Default below is a
# commonly used public actor id ("apify/instagram-scraper") — swap this for
# whichever Instagram actor you rent from the Apify Store; if you change it,
# double check backend/app/scrapers/instagram.py's normalize_instagram_item()
# still matches that actor's output field names.
APIFY_INSTAGRAM_ACTOR_ID=apify/instagram-scraper
# Safety cap so a misconfigured run can't blow through your monthly credit.
APIFY_MAX_POSTS_PER_CHANNEL=30

# ── Shared secret that protects POST /api/scrape/run ────────────────────────
# Generate one with: python -c "import secrets; print(secrets.token_urlsafe(32))"
SCRAPE_TRIGGER_API_KEY=REPLACE_WITH_A_RANDOM_SECRET

# ── SponsorBlock (https://wiki.sponsor.ajay.app/w/API_Docs) ────────────────
# Free, crowdsourced, YouTube-only database of sponsor/self-promo segments —
# no API key needed. Flags which competitor videos are running a
# sponsorship/campaign. Licensed data: the dashboard credits SponsorBlock in
# its sidebar as required — see app/sponsorblock.py's module docstring
# before repurposing this beyond an internal team tool.
SPONSORBLOCK_ENABLED=true
SPONSORBLOCK_API_BASE=https://sponsor.ajay.app
# Comma-separated SponsorBlock categories counted as "sponsored" for the
# dashboard's badge/filter (the full category list is documented in
# app/sponsorblock.py — most of it, like intro/outro/filler, is structural
# rather than commercial, so it's deliberately not included here).
SPONSORBLOCK_CATEGORIES=sponsor,selfpromo,exclusive_access
# Don't re-check a video against SponsorBlock more often than this.
SPONSORBLOCK_RECHECK_HOURS=24
# Caps SponsorBlock lookups per YouTube scrape run (shared across every
# channel that run) so a big backfill can't blow the scrape job's time
# limit or SponsorBlock's rate limit — leftovers get picked up next run.
SPONSORBLOCK_MAX_CHECKS_PER_SCRAPE=40

# ── Overperformance settings ────────────────────────────────────────────────
# A video "overperforms" once views >= OVERPERFORM_RATIO_DEFAULT x its
# channel's rolling baseline for that video format.
OVERPERFORM_RATIO_DEFAULT=2.0
# How many of a channel's previous same-format videos to average for the
# baseline.
BASELINE_WINDOW_VIDEOS=10
# Minimum prior videos needed before a baseline/ratio is computed at all.
BASELINE_MIN_VIDEOS=3

# ── CORS ─────────────────────────────────────────────────────────────────────
# Comma-separated list of origins allowed to call this API (your frontend's
# deployed URL + http://localhost:5173 for local dev).
CORS_ORIGINS=http://localhost:5173,http://localhost:4173

# ── Misc ─────────────────────────────────────────────────────────────────────
WORKSPACE_NAME=Consumer Tech Competitors
# Enable the in-process daily scheduler (APScheduler). Turn this OFF (false)
# on serverless / scale-to-zero hosts (Vercel, Render free web service) and
# use the GitHub Actions cron workflow instead — see backend/README.md.
ENABLE_INTERNAL_SCHEDULER=false
# 24h local time (server TZ) the internal scheduler fires at, if enabled.
DAILY_SCRAPE_HOUR=6
DAILY_SCRAPE_MINUTE=0
# YouTube's own daily quota ceiling for your Google Cloud project — only used
# to render the sidebar's "API Quota" widget as a percentage; doesn't enforce
# anything. 10,000 is Google's standard free-tier default, change only if
# yours differs.
YOUTUBE_DAILY_QUOTA_BUDGET=10000

# ── Manual "Refresh now" button in the dashboard ────────────────────────────
# POST /api/scrape/run-manual (what the dashboard's own refresh button
# calls) has no API key — the browser has nowhere secret to keep one, since
# anything shipped in the JS bundle is visible to anyone who opens dev
# tools. Instead it refuses to start a new scrape within this many seconds
# of the last one (any trigger source counts, including the scheduled
# GitHub Actions runs), capping how much YouTube quota / Apify credit
# repeated clicks or a shared link could spend.
MANUAL_SCRAPE_COOLDOWN_SECONDS=300
